# OpenAI-compatible LLM 配置；复制为 .env 后仅在本地填写真实密钥。
# 默认值与 config.py 一致（DeepSeek）；换用其他服务时三项都要改，且 LLM_THINKING 要改回 auto。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60.0
# LLM 请求是否使用 HTTP(S)_PROXY 等系统代理；默认 false，必须经代理出网时改为 true。
LLM_TRUST_ENV=false
# 是否向 OpenAI-compatible 服务发送 thinking 开关。auto=不发送（沿用服务端默认，
# DeepSeek 下思考默认开启）；enabled/disabled 显式开或关。DeepSeek 默认 disabled；
# 非 DeepSeek 服务必须填 auto，否则可能返回 400。
LLM_THINKING=disabled

# 本地 Embedding、Chunk、Context 与存储配置。
EMBEDDING_MODEL=BAAI/bge-m3
SOURCE_DOCS_PATH=data/source_docs
CHUNK_SIZE=512
# 仅 fixed 策略使用；hybrid 策略冻结窗口重叠为 0（PH1 语义）。
CHUNK_OVERLAP=64
# Chunk 切分策略（Phase 13F 晋升）：hybrid = 结构解析 + 混合切分；fixed = 原固定窗口（回滚）。
CHUNK_STRATEGY=hybrid
MAX_CONTEXT_TOKENS=4096
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_INPUT_K=20
RERANKER_FINAL_K=5
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=cpu
RERANKER_DTYPE=float32
VECTOR_DB_PATH=data/chroma
INDEX_STATE_PATH=artifacts/phase15a/index_state.json
# 通常不需要设置，以 lifecycle 的 active 指针为准（INDEX_STATE_PATH 指向状态文件）。
# 显式设置且与 active 不一致时，线上会拒绝启动；仅在没有状态文件的全新环境中才作为回落值。
# COLLECTION_NAME=ef_research_bge_m3_hybrid_c512_v2
