# OpenAI-compatible LLM settings; copy to .env and fill in real keys locally only.
# Defaults match config.py (DeepSeek); to use another service, change all three and set
# LLM_THINKING back to auto.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60.0
# Whether LLM requests use the system proxy (HTTP(S)_PROXY). Default false; set true when
# outbound traffic must go through a proxy.
LLM_TRUST_ENV=false
# Whether the thinking switch is sent to an OpenAI-compatible service. auto = do not send it
# (keep the server default, thinking is on by default on DeepSeek); enabled/disabled forces it
# on or off. DeepSeek defaults to disabled; non-DeepSeek services must use auto, otherwise the
# request may fail with HTTP 400.
LLM_THINKING=disabled

# Local embedding, chunking, context and storage settings.
EMBEDDING_MODEL=BAAI/bge-m3
SOURCE_DOCS_PATH=data/source_docs
CHUNK_SIZE=512
# Used by the fixed strategy only; the hybrid strategy freezes window overlap at 0 (PH1 semantics).
CHUNK_OVERLAP=64
# Chunking strategy (promoted in Phase 13F): hybrid = structural parsing + hybrid splitting;
# fixed = the original fixed window (rollback option).
CHUNK_STRATEGY=hybrid
MAX_CONTEXT_TOKENS=4096
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_INPUT_K=20
RERANKER_FINAL_K=5
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=cpu
RERANKER_DTYPE=float32
VECTOR_DB_PATH=data/chroma
INDEX_STATE_PATH=artifacts/phase15a/index_state.json
# Usually left unset; the lifecycle active pointer is authoritative (INDEX_STATE_PATH points at
# the state file). If set explicitly and inconsistent with the active pointer, production
# refuses to start; it only acts as a fallback in a fresh environment with no state file.
# COLLECTION_NAME=ef_research_bge_m3_hybrid_c512_v2
