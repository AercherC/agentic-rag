# Local secrets and runtime configuration: only the redacted .env.example is committed.
.env

# Python interpreter, test and static-analysis caches.
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local model caches, vector index and one-off intermediate artifacts.
.cache/
data/chroma/
tmp/

# Local state of developer tooling.
.vscode/
.workbuddy/

# Common OS temporary files.
.DS_Store
Thumbs.db
